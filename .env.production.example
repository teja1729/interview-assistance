# Copy to root .env for Compose interpolation; app credentials belong in backend/.env.
PUBLIC_HOST=interviews.example.com
PUBLIC_URL=https://interviews.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# TOML [agents] assigns each role; this fallback fills only omitted roles.
AI_DEFAULT_PROFILE=sarvam
