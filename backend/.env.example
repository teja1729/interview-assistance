# Normal use requires Google credentials and a live AI key. Test fixtures are opt-in only.
APP_ENV=development
DATABASE_URL=sqlite:///data/saas.db
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=development-only-change-before-deploying
AUTH_DEMO_ENABLED=false
# Role assignments in backend/config/models.toml take precedence over this fallback.
AI_DEFAULT_PROFILE=sarvam
INLINE_WORKER=false
# Optional operator allowance for local development only; never changes production plans.
LOCAL_USAGE_OVERRIDES=false
LOCAL_INTERVIEW_LIMIT=100
LOCAL_AI_CALL_LIMIT=5000

# Google Cloud OAuth client: Web application; redirect URI below must match exactly.
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn "Sign In with LinkedIn using OpenID Connect".
# http://localhost:3000/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Profiles and model IDs are declared in config/models.toml.
GEMINI_API_KEY=
# Search model routing is the company_research role in config/models.toml.
COMPANY_RESEARCH_ENABLED=true
OPENAI_API_KEY=
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=
# Required for compatible profiles: verify the selected model's actual context window.
COMPATIBLE_CONTEXT_TOKENS=0

# Voice-to-voice defaults to Sarvam. Keep credentials above; voice settings are operator-owned.
AUDIO_PROVIDER=sarvam
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=ritu
SPEECH_LANGUAGE=en-IN
# Optional Gemini speech alternative. browser is only a typed-input/local-speech fallback.
TRANSCRIPTION_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Optional paid subscriptions. Both API and webhook secrets are required to enable checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
